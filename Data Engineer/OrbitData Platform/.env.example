# ======================
# OrbitData Platform
# ======================

COMPOSE_PROJECT_NAME=orbitdata
TZ=Europe/Moscow

# PostgreSQL
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit_secret
POSTGRES_DB=orbitdata

# MongoDB
MONGO_USER=orbit
MONGO_PASSWORD=orbit_secret
MONGO_DB=orbitdata

# ClickHouse
CLICKHOUSE_USER=orbit
CLICKHOUSE_PASSWORD=orbit_secret
CLICKHOUSE_DB=orbitdata

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# NiFi
NIFI_USERNAME=admin
NIFI_PASSWORD=admin1234567890

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
