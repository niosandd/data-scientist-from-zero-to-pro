                ],
                "description": "Opens Grafana Assistant",
                "title": "Grafana Assistant"
            },
            {
                "targets": [
                    "grafana/datasources/config/status"
                ],
                "description": "Explain in Assistant",
                "title": "Explain in Assistant"
            },
            {
                "targets": [
                    "grafana/traceview/header/actions"
                ],
                "description": "AI Trace Analysis",
                "title": "Analyze trace with AI assistant"
            }
        ],
        "addedLinks": [
            {
                "targets": [
                    "grafana/extension-sidebar/v0-alpha"
                ],
                "description": "Opens Grafana Assistant",
                "title": "Grafana Assistant"
            },
            {
                "targets": [
                    "grafana/dashboard/panel/menu"
                ],
                "description": "Explain what this panel shows",
                "title": "Explain in Assistant"
            },
            {
                "targets": [
                    "grafana/dashboard/panel/menu"
                ],
                "description": "Diagnose why this panel may not be working correctly",
                "title": "Troubleshoot panel"
            },
            {
                "targets": [
                    "grafana/dashboard/panel/menu"
                ],
                "description": "Analyze the data shown in this panel",
                "title": "Analyze data"
            },
            {
                "targets": [
                    "grafana/dashboard/panel/menu"
                ],
                "description": "Suggest visualization and query improvements for this panel",
                "title": "Suggest improvements"
            },
            {
                "targets": [
                    "grafana/commandpalette/action"
                ],
                "description": "✨ Open Assistant",
                "title": "✨ Open Assistant"
            },
            {
                "targets": [
                    "grafana/commandpalette/action"
                ],
                "description": "Assistant Skills",
                "title": "Assistant Skills"
            },
            {
                "targets": [
                    "grafana/commandpalette/action"
                ],
                "description": "Assistant Automations",
                "title": "Assistant Automations"
            },
            {
                "targets": [
                    "grafana/commandpalette/action"
                ],
                "description": "Assistant Watchers",
                "title": "Assistant Watchers"
            }
        ],
        "extensionPoints": [
            {
                "id": "grafana-assistant-app/extension/v1",
                "title": "Grafana Assistant extension",
                "description": "App plugins register a manifest function here to contribute tool cards, widget detectors, starters, artifact kinds, and prompt contributions to the Grafana Assistant."
            }
        ],
        "exposedComponents": [
            {
                "id": "grafana-assistant-app/connect/v1",
                "title": "Connect to Grafana Cloud",
                "description": "Starts the Grafana Cloud connection flow for self-hosted Grafana"
            },
            {
                "id": "grafana-assistant-app/view-report/v1",
                "title": "Investigation Findings",
                "description": "Displays minimal investigation key findings"
            },
            {
                "id": "grafana-assistant-app/investigation-status/v1",
                "title": "Investigation Status",
                "description": "Displays investigation status with animated progress indicator, summary, and duration"
            },
            {
                "id": "grafana-assistant-app/view-report/v2",
                "title": "Investigation Report (v2)",
                "description": "Renders the v2 Lodestone investigation report for the given investigationId"
            },
            {
                "id": "grafana-assistant-app/workspace-link/v1",
                "title": "Open in Workspace",
                "description": "Button that opens the Grafana Assistant workspace for the given investigation"
            },
            {
                "id": "grafana-assistant-app/fullscreen-workspace/v1",
                "title": "Fullscreen Workspace",
                "description": "Fullscreen workspace (chat + canvas + Platform tab) rendered inside Grafana fullscreen workspace"
            }
        ]
    },
