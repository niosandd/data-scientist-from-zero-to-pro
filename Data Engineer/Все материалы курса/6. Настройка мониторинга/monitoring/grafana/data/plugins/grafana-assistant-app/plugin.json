{
    "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
    "type": "app",
    "name": "Grafana Assistant",
    "id": "grafana-assistant-app",
    "autoEnabled": true,
    "backend": true,
    "executable": "gpx_dash",
    "info": {
        "keywords": [
            "app",
            "assistant",
            "ai",
            "copilot",
            "natural language",
            "llm",
            "claude",
            "chatgpt",
            "openai",
            "codex",
            "dashboard",
            "PromQL",
            "LogQL",
            "SQL",
            "troubleshooting",
            "root cause analysis",
            "rca"
        ],
        "description": "AI assistant for Grafana that helps teams troubleshoot issues, query telemetry, manage dashboards, and navigate Grafana in Cloud or connected self-managed deployments.",
        "author": {
            "name": "Grafana"
        },
        "logos": {
            "small": "img/logo.svg",
            "large": "img/logo.svg"
        },
        "screenshots": [],
        "version": "2.0.46",
        "updated": "2026-08-05",
        "links": [
            {
                "name": "documentation",
                "url": "https://grafana.com/docs/grafana-cloud/machine-learning/assistant/get-started/"
            },
            {
                "name": "repository",
                "url": "https://github.com/grafana/grafana"
            }
        ]
    },
    "dependencies": {
        "grafanaDependency": ">=13.0.0-0",
        "plugins": [],
        "extensions": {
            "exposedComponents": [
                "grafana-exploretraces-app/embedded-trace-exploration/v1",
                "grafana-metricsdrilldown-app/mini-breakdown-component/v1"
            ]
        }
    },
    "includes": [
        {
            "type": "page",
            "name": "Grafana Assistant",
            "path": "/a/grafana-assistant-app",
            "addToNav": true,
            "defaultNav": true
        },
        {
            "type": "page",
            "name": "Workspace",
            "path": "/a/grafana-assistant-app/workspace",
            "addToNav": true,
            "defaultNav": false
        },
        {
            "type": "page",
            "name": "Investigations",
            "path": "/a/grafana-assistant-app/investigations",
            "addToNav": true,
            "defaultNav": false,
            "action": "grafana-assistant-app.investigations:read"
        },
        {
            "type": "page",
            "name": "Automations",
            "path": "/a/grafana-assistant-app/automations",
            "addToNav": true,
            "defaultNav": false,
            "action": "grafana-assistant-app.automations.user:read"
        },
        {
            "type": "page",
            "name": "Watchers",
            "path": "/a/grafana-assistant-app/watchers",
            "addToNav": true,
            "defaultNav": false,
            "action": "grafana-assistant-app.watcher-agents:read"
        },
        {
            "type": "page",
            "name": "Search",
            "path": "/a/grafana-assistant-app/assistant-search",
            "addToNav": true,
            "defaultNav": false
        },
        {
            "type": "page",
            "name": "Usage",
            "path": "/a/grafana-assistant-app/usage",
            "addToNav": true,
            "defaultNav": false,
            "action": "grafana-assistant-app.usage:read"
        },
        {
            "type": "page",
            "name": "Settings",
            "path": "/a/grafana-assistant-app/settings",
            "addToNav": true,
            "defaultNav": false
        },
        {
            "type": "panel",
            "name": "Grafana Assistant panel",
            "path": "features/assistant-panel/plugin.json"
        }
    ],
    "extensions": {
        "addedComponents": [
            {
                "targets": [
                    "grafana/homepage/assistant/v1"
                ],
                "description": "Opens Grafana Assistant",
                "title": "Grafana Assistant"
            },
            {
